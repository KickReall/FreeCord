<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FreeCord.Desktop.Views.ConfirmDialog"
        Title="FreeCord" Width="360" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="#2B2D31">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Name="MessageText" Foreground="#DBDEE1" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Отмена" Click="OnCancel"/>
            <Button Name="ConfirmButton" Content="Да" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
