<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreeCord.Desktop.ViewModels"
        xmlns:views="using:FreeCord.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="FreeCord.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FreeCord" Width="900" Height="600"
        Background="#2B2D31">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Общие акценты в духе Discord: скруглённые кнопки, blurple как акцентный
             цвет действия, мягкая подсветка выбранных/наведённых строк списков. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4752C4"/>
        </Style>
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3F4147"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#1E1F22"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="Foreground" Value="#949BA4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,12,4,4"/>
        </Style>
    </Window.Styles>

    <!-- Панель настроек сервера — оверлей поверх всего окна (не отдельное Window),
         поэтому корневое содержимое обёрнуто в Panel: второй слой (тёмная подложка +
         сама панель) рисуется поверх первого просто по порядку следования в XAML. -->
    <Panel>
    <Grid ColumnDefinitions="72,*">

        <!-- Левая панель — список подключённых серверов -->
        <Border Grid.Column="0" Background="#1E1F22">
            <Grid RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" ItemsSource="{Binding Servers}" SelectedItem="{Binding ActiveServer}"
                         Background="Transparent" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <!-- Стили только для ListBoxItem этого конкретного списка — активный/наведённый
                         кружок выделяется формой (скругление 24 -> 16) и акцентным цветом. -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                        <Style Selector="ListBoxItem Border#ServerAvatar">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.12"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:selected Border#ServerAvatar">
                            <Setter Property="CornerRadius" Value="16"/>
                            <Setter Property="Background" Value="#5865F2"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border#ServerAvatar">
                            <Setter Property="CornerRadius" Value="16"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerSessionViewModel">
                            <Border x:Name="ServerAvatar" Width="48" Height="48" CornerRadius="24" Background="#313338" Margin="0,4"
                                    ClipToBounds="True" ToolTip.Tip="{Binding DisplayName}">
                                <!-- Переименование и иконка сервера убраны отсюда — имя и иконка теперь
                                     глобальные, задаёт владелец в окне настроек сервера (шестерёнка). -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Переместить вверх"
                                                  Command="{Binding $parent[Window].DataContext.MoveServerUpCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Переместить вниз"
                                                  Command="{Binding $parent[Window].DataContext.MoveServerDownCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Удалить сервер"
                                                  Command="{Binding $parent[Window].DataContext.RemoveServerCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Panel>
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                               IsVisible="{Binding !HasServerIcon}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding ServerIcon}" IsVisible="{Binding HasServerIcon}" Stretch="UniformToFill"/>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="1" Classes="flat" Content="+" Command="{Binding AddServerCommand}"
                        Width="48" Height="48" CornerRadius="24" Margin="0,8,0,16" Padding="0"
                        Background="#313338" Foreground="#3BA55D"
                        HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" FontSize="20" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Плейсхолдер, пока ни один сервер не выбран/не добавлен -->
        <TextBlock Grid.Column="1" Text="Добавьте сервер через + слева"
                   IsVisible="{Binding !HasActiveServer}"
                   Foreground="#949BA4" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Интерфейс активного сервера -->
        <Grid Grid.Column="1" IsVisible="{Binding HasActiveServer}">
            <Grid DataContext="{Binding ActiveServer}" x:DataType="vm:ServerSessionViewModel"
                  RowDefinitions="*,Auto">

                <!-- Панель логина -->
                <Border Grid.Row="0" IsVisible="{Binding !IsLoggedIn}"
                        Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12" Width="300">
                        <TextBlock Text="FreeCord" FontSize="28" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <CheckBox Content="Подключиться по инвайт-ссылке" IsChecked="{Binding UseInviteLink}"/>

                        <StackPanel IsVisible="{Binding !UseInviteLink}" Spacing="12">
                            <TextBlock Text="Server" Foreground="#949BA4"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Host}" PlaceholderText="host"/>
                                <TextBox Grid.Column="1" Text="{Binding Port}" Width="70" Margin="6,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding UseInviteLink}" Spacing="12">
                            <TextBlock Text="Инвайт-ссылка" Foreground="#949BA4"/>
                            <TextBox Text="{Binding InviteLinkText}" PlaceholderText="freecord://host:port?fp=..."/>
                        </StackPanel>

                        <TextBlock Text="Username" Foreground="#949BA4"/>
                        <TextBox Text="{Binding Username}"/>

                        <TextBlock Text="Password" Foreground="#949BA4"/>
                        <TextBox Text="{Binding Password}" PasswordChar="•"/>

                        <Button Classes="accent" Content="Log in" Command="{Binding LoginCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <!-- IsPersisted означает, что на этом сервере уже был хотя бы один успешный
                             вход (см. PersistIfNeeded) — регистрировать здесь больше нечего. -->
                        <Button Content="Register" Command="{Binding RegisterCommand}"
                                IsVisible="{Binding !IsPersisted}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                        <!-- Сюда же попадают статусы автопереподключения при обрыве связи -->
                        <TextBlock Text="{Binding Status}" Foreground="#949BA4" FontSize="12"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Панель чата -->
                <Grid Grid.Row="0" IsVisible="{Binding IsLoggedIn}"
                      ColumnDefinitions="220,*,Auto,Auto">

                    <!-- Список комнат -->
                    <Border Grid.Column="0" Background="#2B2D31">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Border Grid.Row="0" Padding="16,14" BorderBrush="#1E1F22" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold"
                                               FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <!-- Настройки сервера — по правам, а не жёстко только Owner'у/admin'у:
                                         видно, если есть хоть одно из административных прав (см.
                                         CanOpenServerSettings) — Owner их всё равно имеет как admin. -->
                                    <Button Grid.Column="1" Classes="flat" Content="⚙" FontSize="15"
                                            Command="{Binding OpenServerSettingsCommand}"
                                            IsVisible="{Binding CanOpenServerSettings}"
                                            Padding="4" ToolTip.Tip="Настройки сервера"/>
                                </Grid>
                            </Border>

                            <Button Grid.Row="1" Content="🔗 Скопировать инвайт-ссылку"
                                    Command="{Binding $parent[Window].DataContext.CopyInviteLinkCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    FontSize="11" Margin="8,8,8,0"/>

                            <ScrollViewer Grid.Row="2" Margin="0,4,0,0">
                                <StackPanel Margin="8,0,8,0">
                                    <TextBlock Classes="sectionHeader" Text="ТЕКСТОВЫЕ КАНАЛЫ"/>
                                    <ListBox ItemsSource="{Binding TextRooms}" SelectedItem="{Binding SelectedRoom}"
                                             Background="Transparent">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="CornerRadius" Value="4"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#3F4147"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#35373C"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat='#  {0}'}" Foreground="#DBDEE1"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Пока всегда пусто — задел на будущее (голосовые каналы, план в CLAUDE.md) -->
                                    <TextBlock Classes="sectionHeader" Text="ГОЛОСОВЫЕ КАНАЛЫ"/>
                                    <ListBox ItemsSource="{Binding VoiceRooms}" SelectedItem="{Binding SelectedRoom}"
                                             Background="Transparent">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="CornerRadius" Value="4"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#3F4147"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#35373C"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat='🔊  {0}'}" Foreground="#DBDEE1"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="8,8,8,8"
                                  IsVisible="{Binding CanManageChannel}">
                                <TextBox Grid.Column="0" Text="{Binding NewRoomName}" PlaceholderText="новый канал"/>
                                <Button Grid.Column="1" Classes="accent" Content="+" Margin="4,0,0,0"
                                        Command="{Binding CreateRoomCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Лента сообщений -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="16,12,16,12">
                        <Border Grid.Row="0" BorderBrush="#1E1F22" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,4">
                            <TextBlock Foreground="White" FontSize="16" FontWeight="Bold"
                                       Text="{Binding SelectedRoom.Name, StringFormat='#  {0}', FallbackValue='Выберите канал'}"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" Name="MessagesScroll">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                                            <TextBlock Grid.Column="0" Text="{Binding Author}"
                                                       Foreground="#8AB4F8" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                       Foreground="#DBDEE1" TextWrapping="Wrap" Margin="8,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                       Foreground="#6D6F78" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" Text="{Binding TypingIndicatorText}"
                                   Foreground="#8AB4F8" FontSize="12" FontStyle="Italic" Margin="2,4,0,0"
                                   IsVisible="{Binding HasTypingIndicator}"/>

                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0"
                              IsVisible="{Binding HasSelectedRoom}">
                            <TextBox Grid.Column="0" Text="{Binding MessageText}"
                                     IsEnabled="{Binding CanSendInSelectedRoom}"
                                     PlaceholderText="{Binding MessageInputPlaceholder}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Classes="accent" Content="Отправить" Margin="6,0,0,0"
                                    IsEnabled="{Binding CanSendInSelectedRoom}"
                                    Command="{Binding SendMessageCommand}"/>
                        </Grid>
                    </Grid>

                    <!-- Узкая полоска-разделитель — всегда видна, даже когда панель участников скрыта,
                         иначе кнопку показать её обратно негде было бы разместить. -->
                    <Border Grid.Column="2" Width="18" Background="#2B2D31">
                        <Button Classes="flat" Command="{Binding ToggleMembersCommand}"
                                Content="{Binding MembersToggleGlyph}"
                                Foreground="#949BA4" FontSize="14" FontWeight="Bold"
                                Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Показать/скрыть участников"/>
                    </Border>

                    <!-- Панель участников — сгруппированы по роли с наибольшими правами -->
                    <Border Grid.Column="3" Width="200" Background="#2B2D31" Padding="8"
                            IsVisible="{Binding ShowMembers}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding MemberGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoleGroupViewModel">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Classes="sectionHeader" Text="{Binding Header}" Margin="4,0,4,6"/>
                                            <ItemsControl ItemsSource="{Binding Members}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MemberViewModel">
                                                        <Border CornerRadius="4" Padding="4,4" Background="Transparent">
                                                            <Border.Styles>
                                                                <Style Selector="Border:pointerover">
                                                                    <Setter Property="Background" Value="#35373C"/>
                                                                </Style>
                                                            </Border.Styles>
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                                                    <Border CornerRadius="12" Background="#313338" ClipToBounds="True">
                                                                        <Image Source="{Binding Avatar}" IsVisible="{Binding HasAvatar}" Stretch="UniformToFill"/>
                                                                    </Border>
                                                                    <Ellipse Width="9" Height="9" Stroke="#2B2D31" StrokeThickness="2"
                                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                             Fill="{Binding PresenceBrush}"/>
                                                                </Grid>
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                           Foreground="#DBDEE1" VerticalAlignment="Center"
                                                                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                <!-- Выдача роли/блокировка/удаление и загрузка своей аватарки убраны
                                                                     отсюда — переезжают в окно настроек сервера (вкладка "Пользователи")
                                                                     и в будущий экран настроек профиля. Локальное имя доступно всем и
                                                                     на любого, кроме себя самого — смысла в нём для своей строки нет. -->
                                                                <Grid.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Это вы" IsEnabled="False"
                                                                                  IsVisible="{Binding IsSelf}"/>
                                                                        <MenuItem Header="Переименовать (локально)"
                                                                                  Command="{Binding $parent[Window].DataContext.ActiveServer.RenameMemberCommand}"
                                                                                  CommandParameter="{Binding}"
                                                                                  IsVisible="{Binding !IsSelf}"/>
                                                                    </ContextMenu>
                                                                </Grid.ContextMenu>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Статусная строка -->
                <Border Grid.Row="1" Background="#1E1F22" Padding="12,6">
                    <TextBlock Text="{Binding Status}" Foreground="#949BA4" FontSize="12"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>

    <!-- Тёмная подложка блокирует клики по всему, что под ней, просто тем, что у нeё
         есть непрозрачный (полупрозрачный) Background — в Avalonia элемент с реальным
         фоном перехватывает попадания указателя, элементы за ним их уже не получают. -->
    <Border Background="#B0000000" IsVisible="{Binding IsServerSettingsOpen}">
        <Border Width="820" Height="560" Background="#2B2D31" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True">
            <views:ServerSettingsPanel DataContext="{Binding ActiveServerSettings}"/>
        </Border>
    </Border>
    </Panel>
</Window>
